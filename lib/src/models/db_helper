// Pure in-memory stub — replaces the old sqflite DBHelper.
// All callers that did `await DBHelper.instance.warmUp()` or
// `DBHelper.instance.database` will compile and run fine.

class DBHelper {
  DBHelper._();
  static final DBHelper instance = DBHelper._();

  // Called from main.dart: await DBHelper.instance.warmUp();
  Future<void> warmUp() async {
    // Nothing to do — all models use in-memory caches backed by Firestore.
  }

  // Kept so any legacy callers that accessed `.database` don't crash.
  Future<void> get database async {}
}